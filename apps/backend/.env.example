# Django
DJANGO_SECRET_KEY=change-me-in-production-please
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://sazeh:sazeh@localhost:5432/sazeh

# Redis
REDIS_URL=redis://localhost:6379/0

# AWS / S3 (for media & publishing)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=sazeh-media
AWS_S3_REGION_NAME=us-east-1

# LLM Provider (OpenAI-compatible — set base URL, key, and model)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Celery
