{
  "name": "FeatureGrid",
  "display_name": "Feature Grid",
  "category": "composite",
  "description": "A titled grid of feature cards (icon, title, description) in 2, 3, or 4 columns.",
  "icon": "layout-grid",
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "FeatureGrid",
    "type": "object",
    "additionalProperties": false,
    "required": ["title", "features"],
    "properties": {
      "title": { "type": "string", "maxLength": 100 },
      "subtitle": { "type": "string", "maxLength": 250 },
      "columns": { "type": "integer", "enum": [2, 3, 4], "default": 3 },
      "features": {
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "items": {
          "type": "object",
          "required": ["title", "description", "icon"],
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string", "maxLength": 60 },
            "description": { "type": "string", "maxLength": 200 },
            "icon": {
              "type": "string",
              "enum": [
                "zap", "shield", "layers", "cpu", "globe",
                "lock", "refresh", "check-circle", "star", "code"
              ]
            }
          }
        }
      }
    }
  },
  "default_props": {
    "title": "Features",
    "columns": 3,
    "features": [
      { "title": "Feature", "description": "Describe the value here.", "icon": "zap" }
    ]
  },
  "allowed_children": [],
  "example_payload": {
    "title": "Everything you need to ship",
    "subtitle": "From first draft to published site, in one place.",
    "columns": 3,
    "features": [
      { "title": "Chat to build", "description": "Describe a page and watch it appear.", "icon": "zap" },
      { "title": "Drag and drop", "description": "Refine every section by hand — no AI needed.", "icon": "layers" },
      { "title": "Publish anywhere", "description": "One click to a live URL, ZIP, or GitHub.", "icon": "globe" }
    ]
  }
}
