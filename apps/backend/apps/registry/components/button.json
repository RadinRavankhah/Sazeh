{
  "name": "Button",
  "display_name": "Button",
  "category": "primitive",
  "description": "A clickable button with configurable label, variant, and URL.",
  "icon": "button",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "label": { "type": "string", "minLength": 1 },
      "url": { "type": "string", "format": "uri" },
      "variant": { "type": "string", "enum": ["default", "primary", "secondary", "outline", "ghost"] },
      "size": { "type": "string", "enum": ["sm", "md", "lg"] },
      "open_in_new_tab": { "type": "boolean" }
    },
    "required": ["label"]
  },
  "default_props": {
    "label": "Click Me",
    "variant": "primary",
    "size": "md",
    "open_in_new_tab": false
  },
  "allowed_children": []
}
