{
  "name": "FAQAccordion",
  "display_name": "FAQ Accordion",
  "category": "composite",
  "description": "A titled list of expandable question/answer items. Maps to shadcn/ui Accordion.",
  "icon": "circle-help",
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "FAQAccordion",
    "type": "object",
    "additionalProperties": false,
    "required": ["items"],
    "properties": {
      "title": { "type": "string", "maxLength": 100, "default": "Frequently Asked Questions" },
      "subtitle": { "type": "string", "maxLength": 250 },
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "items": {
          "type": "object",
          "required": ["question", "answer"],
          "additionalProperties": false,
          "properties": {
            "question": { "type": "string", "maxLength": 150 },
            "answer": { "type": "string", "maxLength": 600 }
          }
        }
      }
    }
  },
  "default_props": {
    "title": "Frequently Asked Questions",
    "items": [
      { "question": "Your question?", "answer": "Your answer." }
    ]
  },
  "allowed_children": [],
  "example_payload": {
    "title": "Frequently Asked Questions",
    "items": [
      { "question": "Do I need to know how to code?", "answer": "No. Build by chatting with the agent or by dragging sections into place — both write the same site." },
      { "question": "Can I use my own domain?", "answer": "Custom domains are coming soon; every site ships with a free subdomain at launch." }
    ]
  }
}
